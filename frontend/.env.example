# RouteMeV2 — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it contains secrets.

# Mapbox (required for route map display)
# Get a free token at https://account.mapbox.com/access-tokens/
REACT_APP_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Supabase (required for auth + database)
# Find these in your Supabase project Settings > API
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenWeather (optional — weather overlay on dashboard)
# Used server-side by the Express proxy. Set via Render env vars (not .env).
# Get a free key at https://openweathermap.org/api
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenRouter (optional — AI SOAP note generation)
# Get a key at https://openrouter.ai/keys
REACT_APP_OPENROUTER_API_KEY=

# Stripe (required for subscription billing)
# Create Stripe account at https://dashboard.stripe.com
# STRIPE_SECRET_KEY=sk_test_... (server-side, set in Render env vars)
# STRIPE_PUBLISHABLE_KEY=pk_test_... (for optional Stripe Elements)
# STRIPE_WEBHOOK_SECRET=whsec_... (from Stripe Dashboard > Webhooks)
# STRIPE_PRICE_GROWTH_MONTHLY=price_... (Stripe Dashboard > Products)
# STRIPE_PRICE_GROWTH_ANNUAL=price_...
# STRIPE_PRICE_SCALE_MONTHLY=price_...
# STRIPE_PRICE_SCALE_ANNUAL=price_...

# App URL (used for Stripe success/cancel redirects)
# APP_URL=https://routeme.onrender.com (set in Render env vars)